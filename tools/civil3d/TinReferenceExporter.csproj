<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Version>0.1.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Civil3DDir Condition="'$(Civil3DDir)' == ''">C:\Program Files\Autodesk\AutoCAD 2026</Civil3DDir>
    <Civil3DAssemblyDir Condition="'$(Civil3DAssemblyDir)' == ''">$(Civil3DDir)\C3D</Civil3DAssemblyDir>
    <AecAssemblyDir Condition="'$(AecAssemblyDir)' == ''">$(Civil3DDir)\ACA</AecAssemblyDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="AcCoreMgd" HintPath="$(Civil3DDir)\AcCoreMgd.dll" Private="false" />
    <Reference Include="AcDbMgd" HintPath="$(Civil3DDir)\AcDbMgd.dll" Private="false" />
    <Reference Include="AcMgd" HintPath="$(Civil3DDir)\AcMgd.dll" Private="false" />
    <Reference Include="AecBaseMgd" HintPath="$(AecAssemblyDir)\AecBaseMgd.dll" Private="false" />
    <Reference Include="AeccDbMgd" HintPath="$(Civil3DAssemblyDir)\AeccDbMgd.dll" Private="false" />
  </ItemGroup>
</Project>
